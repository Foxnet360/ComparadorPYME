{
  "mcpServers": {
    "codegraph": {
      "command": "/home/foxnet360/.nvm/versions/node/v24.19.0/bin/node",
      "args": [
        "/home/foxnet360/.nvm/versions/node/v24.19.0/lib/node_modules/@colbymchenry/codegraph/npm-shim.js",
        "serve",
        "--mcp"
      ]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": "/home/linuxbrew/.linuxbrew/bin/engram",
      "args": ["mcp", "--tools=agent"]
    },
    "opengraph": {
      "url": "https://mcp.opengraph.io/mcp"
    },
    "railway": {
      "command": "railway",
      "args": ["mcp", "proxy"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase"]
    }
  }
}
