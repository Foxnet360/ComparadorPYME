{
  "name": "comparador-pyme",
  "version": "1.0.0",
  "description": "Comparador de Seguros PYME - Railway Deployment",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "cd server && tsc && mkdir -p dist/data && (cp -r src/data/* dist/data/ 2>/dev/null || true) && (cp -r ../data dist/data 2>/dev/null || true)",
    "preview": "vite preview",
    "start": "node index.js",
    "server:dev": "cd server && ts-node --transpile-only src/index.ts",
    "seed:clauses": "cd server && ts-node --transpile-only src/scripts/seedClauses.ts",
    "test": "vitest run --project unit-backend --project unit-frontend --passWithNoTests",
    "test:unit": "vitest run --project unit-backend --project unit-frontend --passWithNoTests",
    "test:unit:backend": "vitest run --project unit-backend --passWithNoTests",
    "test:unit:frontend": "vitest run --project unit-frontend --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:watch": "vitest --project unit-backend --project unit-frontend",
    "coverage": "vitest run --project unit-backend --project unit-frontend --coverage --passWithNoTests",
    "coverage:integration": "vitest run --project integration --coverage --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck:backend": "cd server && tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit --project tsconfig.json",
    "test:smoke": "./scripts/smoke-tests.sh",
    "evaluate:golden": "cd server && ts-node --transpile-only src/scripts/runEvaluation.ts",
    "deploy": "node .opencode/skills/railway-deploy/deploy.js",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^5.18.3",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-virtual": "^3.14.5",
    "ajv": "^8.20.0",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dompurify": "^3.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "idb": "^8.0.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.4",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^3.11.174",
    "pino": "^9.5.0",
    "rate-limit-redis": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^4.7.0",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.13",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "canvas": "^3.2.1"
  },
  "lint-staged": {
    "server/src/**/*.ts": [
      "sh -c 'cd server && npx tsc --noEmit'",
      "npx eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "npx eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "npx prettier --check"
    ]
  }
}
