{
  "name": "comparador-pyme",
  "version": "1.0.0",
  "description": "Comparador de Seguros PYME - Railway Deployment",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "cd server && tsc && cp -r src/data dist/data",
    "preview": "vite preview",
    "start": "node index.js",
    "server:dev": "cd server && ts-node --transpile-only src/index.ts",
    "seed:clauses": "cd server && ts-node --transpile-only src/scripts/seedClauses.ts",
    "test": "vitest run --passWithNoTests",
    "deploy": "node .opencode/skills/railway-deploy/deploy.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^5.18.3",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.105.1",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^5.2.1",
    "groq": "^5.14.1",
    "groq-sdk": "^1.1.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.14.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.13",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "canvas": "^3.2.1"
  }
}
