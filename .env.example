# Comparador CSA - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED VARIABLES
# ============================================

# Google Gemini API Key (required for AI processing)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (required for database and vector storage)
# Get yours at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Supabase JWT Secret (required in production for secure token validation)
# Get it from Supabase Dashboard → Settings → API → JWT Secret
# In development it can be left empty (token verification is skipped).
SUPABASE_JWT_SECRET=

# Gemini Model Configuration (optional, defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CLAUSE_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Frontend Gemini Key (optional, for client-side features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Regional Configuration (defaults: Colombia)
REGION=CO
SMMLV_VALUE=1423500
UVT_VALUE=42412
CURRENCY=COP

# Server Configuration (defaults shown)
PORT=8080
NODE_ENV=development

# Storage Configuration (default shown)
CLAUSE_PAGES_BUCKET=clause-pages

# Document Processing Limits (defaults shown)
MAX_FILE_SIZE=52428800
MAX_PAGES_LIMIT=100
UPLOAD_TIMEOUT=300000

# Logging (default shown)
LOG_LEVEL=info

# Redis Configuration
# Required for: learningEngine, caching de embeddings, cache de resultados
# En Railway: Usar la URL interna del servicio Redis
# En local: redis://localhost:6379 (requiere Redis instalado)
# Formatos soportados: redis://user:pass@host:port o rediss:// (TLS)
REDIS_URL=redis://localhost:6379
# Ejemplo Railway (Internal): redis://default:YymaPFEKzRuNdHsyCnElykqZXmuaCkHC@redis.railway.internal:6379
# Ejemplo Railway (Public): redis://default:YymaPFEKzRuNdHsyCnElykqZXmuaCkHC@kodama.proxy.rlwy.net:42389

# CORS Origins (optional, defaults to localhost in development)
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Frontend API base URL (used by advanced-analysis hooks; defaults to localhost)
VITE_API_URL=http://localhost:8080/api

# Frontend Feature Flags
# VITE_ENABLE_ADVANCED_ANALYSIS=true   # Enables coverage validation, deductible risk, contextual risk, warranty compliance, legal opinion UI
# VITE_ENABLE_MULTIMODAL_EXTRACTION=false  # Forces legacy extraction path
# VITE_ENABLE_V2_1_FIXES=true
# VITE_ENABLE_V2_2_FIXES=true

# Backend Feature Flags (individual overrides, defaults shown)
# USE_UNIFIED_ENGINE=true              # Routes /api/analyze through the unified engine
# USE_UNIFIED_ENGINE_ROLLOUT=100       # Percentage rollout for the unified engine (0-100)
# USE_UNIFIED_ENGINE_USERS=            # Comma-separated user IDs always enabled
# GRANULAR_COMPARISON_SCHEMA=true      # Section-aware v2 comparison schema
# ENABLE_DEEP_CLAUSE_VALIDATION=false  # Experimental POST /api/comparison/:id/deep-mode (not production-ready)
# ENABLE_MULTIMODAL_EXTRACTION=true    # Multimodal quote extraction v2

# Unified engine LLM timeout (optional, default shown)
GEMINI_UNIFIED_TIMEOUT_MS=120000

# Reconciliation thresholds (optional, JSON object)
# RECONCILIATION_THRESHOLDS={"coverageName":0.85,"deductible":0.75}

# Feature Flags (optional, JSON object to override any default)
# FEATURE_FLAGS='{"learningEngine": false}'
