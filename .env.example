# Comparador CSA - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED VARIABLES
# ============================================

# Google Gemini API Key (required for AI processing)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (required for database and vector storage)
# Get yours at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Supabase JWT Secret (optional, for auth validation)
SUPABASE_JWT_SECRET=

# Gemini Model Configuration (optional, defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CLAUSE_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Frontend Gemini Key (optional, for client-side features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Regional Configuration (defaults: Colombia)
REGION=CO
SMMLV_VALUE=1423500
UVT_VALUE=42412
CURRENCY=COP

# Server Configuration (defaults shown)
PORT=8080
NODE_ENV=development

# Storage Configuration (default shown)
CLAUSE_PAGES_BUCKET=clause-pages

# Document Processing Limits (defaults shown)
MAX_FILE_SIZE=52428800
MAX_PAGES_LIMIT=100
UPLOAD_TIMEOUT=300000

# Logging (default shown)
LOG_LEVEL=info

# Redis (optional, required for learningEngine feature)
# Format: redis://localhost:6379 or rediss:// for TLS
REDIS_URL=

# CORS Origins (optional, defaults to localhost in development)
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Feature Flags (optional, JSON object to override defaults)
# FEATURE_FLAGS='{"learningEngine": false}'
